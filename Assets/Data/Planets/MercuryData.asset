  m_Script: {fileID: 11500000, guid: 3f755dfdaff50f641985bf07b6b22318, type: 3}
  m_Name: MercuryData
  m_EditorClassIdentifier: Assembly-CSharp::SolarSystemAR.Core.PlanetData
  id: 0
  displayName: "\u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0439"
  planetType: "\u041f\u043b\u0430\u043d\u0435\u0442\u0430 \u0437\u0435\u043c\u043d\u043e\u0457 \u0433\u0440\u0443\u043f\u0438"
  diameterKm: 4879
  distanceFromSunMillionKm: 57.9
  dayDuration: "176 \u0437\u0435\u043c\u043d\u0438\u0445 \u0434\u0456\u0431"
  yearDuration: "88 \u0437\u0435\u043c\u043d\u0438\u0445 \u0434\u0456\u0431"
  moonCount: 0
  interestingFact: "\u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0439 \u2014 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0430 \u0439 \u043d\u0430\u0439\u0431\u043b\u0438\u0436\u0447\u0430 \u0434\u043e \u0421\u043e\u043d\u0446\u044f \u043f\u043b\u0430\u043d\u0435\u0442\u0430. \u0420\u0456\u043a \u043d\u0430 \u043d\u0456\u0439 \u0442\u0440\u0438\u0432\u0430\u0454 \u043b\u0438\u0448\u0435 88 \u0437\u0435\u043c\u043d\u0438\u0445 \u0434\u0456\u0431, \u0437\u0430\u0442\u0435 \u043e\u0434\u043d\u0430 \u0434\u043e\u0431\u0430 \u2014 \u0432\u0456\u0434 \u0441\u0445\u043e\u0434\u0443 \u0434\u043e \u0441\u0445\u043e\u0434\u0443 \u0421\u043e\u043d\u0446\u044f \u2014 \u0430\u0436 176."
  discoveryHistory: "\u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0439 \u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u043b\u044e\u0434\u044f\u043c \u0456\u0437 \u0434\u0430\u0432\u043d\u0456\u0445 \u0447\u0430\u0441\u0456\u0432, \u0430\u0434\u0436\u0435 \u0439\u043e\u0433\u043e \u0432\u0438\u0434\u043d\u043e \u043d\u0435\u043e\u0437\u0431\u0440\u043e\u0454\u043d\u0438\u043c \u043e\u043a\u043e\u043c. \u041f\u0435\u0440\u0448\u0438\u0439 \u043a\u043e\u0441\u043c\u0456\u0447\u043d\u0438\u0439 \u0430\u043f\u0430\u0440\u0430\u0442, \u041c\u0430\u0440\u0456\u043d\u0435\u0440-10, \u043f\u0440\u043e\u043b\u0435\u0442\u0456\u0432 \u043f\u043e\u0432\u0437 \u043d\u044c\u043e\u0433\u043e \u0432 1974 \u0440\u043e\u0446\u0456, \u0430 \u0437 2011 \u043f\u043e 2015 \u0440\u0456\u043a \u043f\u043b\u0430\u043d\u0435\u0442\u0443 \u0437 \u043e\u0440\u0431\u0456\u0442\u0438 \u0432\u0438\u0432\u0447\u0430\u0432 \u0430\u043f\u0430\u0440\u0430\u0442 \u041c\u0435\u0441\u0441\u0435\u043d\u0434\u0436\u0435\u0440."
  questions:
  - id: mercury_moons
    question: "\u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0456\u0432 \u0443 \u041c\u0435\u0440\u043a\u0443\u0440\u0456\u044f?"
    answer: "\u0423 \u041c\u0435\u0440\u043a\u0443\u0440\u0456\u044f \u043d\u0435\u043c\u0430\u0454 \u0436\u043e\u0434\u043d\u043e\u0433\u043e \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0430."
    audio: {fileID: 0}
  - id: mercury_life
    question: "\u0427\u0438 \u043c\u043e\u0436\u043d\u0430 \u0436\u0438\u0442\u0438 \u043d\u0430 \u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0457?"
    answer: "\u041d\u0456. \u0423\u0434\u0435\u043d\u044c \u0442\u0430\u043c \u043f\u0435\u043a\u0435\u043b\u044c\u043d\u0430 \u0441\u043f\u0435\u043a\u0430, \u0432\u043d\u043e\u0447\u0456 \u043b\u044e\u0442\u0438\u0439 \u043c\u043e\u0440\u043e\u0437, \u0456 \u043c\u0430\u0439\u0436\u0435 \u043d\u0435\u043c\u0430\u0454 \u043f\u043e\u0432\u0456\u0442\u0440\u044f."
    audio: {fileID: 0}
  - id: mercury_temperature
    question: "\u042f\u043a\u0430 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u043d\u0430 \u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0457?"
    answer: "\u0423\u0434\u0435\u043d\u044c \u043d\u0430 \u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0457 \u0434\u043e 430 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432 \u0442\u0435\u043f\u043b\u0430, \u0430 \u0432\u043d\u043e\u0447\u0456 \u2014 \u0434\u043e \u043c\u0456\u043d\u0443\u0441 180. \u041f\u043e\u0432\u0456\u0442\u0440\u044f \u043c\u0430\u0439\u0436\u0435 \u043d\u0435\u043c\u0430\u0454, \u0442\u043e\u043c\u0443 \u0442\u0435\u043f\u043b\u043e \u043d\u0435 \u0437\u0430\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f."
    audio: {fileID: 0}
