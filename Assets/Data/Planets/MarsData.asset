  id: 3
  displayName: "\u041C\u0430\u0440\u0441"
  image: {fileID: 21300000, guid: f559ed5eaef987e4498658ba8b8467bc, type: 3}
  planetType: "\u041F\u043B\u0430\u043D\u0435\u0442\u0430 \u0437\u0435\u043C\u043D\u043E\u0457 \u0433\u0440\u0443\u043F\u0438"
  diameterKm: 6779
  distanceFromSunMillionKm: 227.9
  dayDuration: "24 \u0433\u043E\u0434\u0438\u043D\u0438 37 \u0445\u0432\u0438\u043B\u0438\u043D"
  yearDuration: "687 \u0437\u0435\u043C\u043D\u0438\u0445 \u0434\u0456\u0431"
  moonCount: 2
  interestingFact: "\u041D\u0430 \u041C\u0430\u0440\u0441\u0456 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0430\u043D\u0430 \u043D\u0430\u0439\u0432\u0438\u0449\u0430 \u0433\u043E\u0440\u0430 \u0421\u043E\u043D\u044F\u0447\u043D\u043E\u0457 \u0441\u0438\u0441\u0442\u0435\u043C\u0438 \u2014 \u0432\u0443\u043B\u043A\u0430\u043D \u041E\u043B\u0456\u043C\u043F. \u0412\u0456\u043D \u043C\u0430\u0439\u0436\u0435 22 \u043A\u0456\u043B\u043E\u043C\u0435\u0442\u0440\u0438 \u0437\u0430\u0432\u0432\u0438\u0448\u043A\u0438, \u0449\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E \u0432 \u0434\u0432\u0430 \u0437 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u044E \u0440\u0430\u0437\u0438 \u0432\u0438\u0449\u0435 \u0437\u0430 \u0415\u0432\u0435\u0440\u0435\u0441\u0442."
  discoveryHistory: "\u041C\u0430\u0440\u0441 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u043B\u0438 \u0449\u0435 \u0432 \u0434\u0430\u0432\u043D\u0438\u043D\u0443, \u0430 \u043D\u0430\u0437\u0432\u0443 \u0432\u0456\u043D \u043E\u0442\u0440\u0438\u043C\u0430\u0432 \u043D\u0430 \u0447\u0435\u0441\u0442\u044C \u0440\u0438\u043C\u0441\u044C\u043A\u043E\u0433\u043E \u0431\u043E\u0433\u0430 \u0432\u0456\u0439\u043D\u0438 \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0440\u0432\u043E\u043D\u0438\u0439 \u043A\u043E\u043B\u0456\u0440. \u0423 1877 \u0440\u043E\u0446\u0456 \u0410\u0441\u0430\u0444 \u0413\u043E\u043B\u043B \u0432\u0456\u0434\u043A\u0440\u0438\u0432 \u0439\u043E\u0433\u043E \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u0424\u043E\u0431\u043E\u0441 \u0456 \u0414\u0435\u0439\u043C\u043E\u0441. \u041F\u0435\u0440\u0448\u0456 \u0437\u043D\u0456\u043C\u043A\u0438 \u0437\u0431\u043B\u0438\u0437\u044C\u043A\u0430 \u0437\u0440\u043E\u0431\u0438\u0432 \u041C\u0430\u0440\u0456\u043D\u0435\u0440-4 \u0443 1965 \u0440\u043E\u0446\u0456, \u0430 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u041C\u0430\u0440\u0441\u043E\u043C \u0457\u0437\u0434\u044F\u0442\u044C \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434\u0438, \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434 \u041F\u0435\u0440\u0441\u0435\u0432\u0435\u0440\u0430\u043D\u0441."
  questions:
  - id: mars_moons
    question: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432 \u0443 \u041C\u0430\u0440\u0441\u0430?"
    answer: "\u0423 \u041C\u0430\u0440\u0441\u0430 \u0434\u0432\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0456 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u2014 \u0424\u043E\u0431\u043E\u0441 \u0456 \u0414\u0435\u0439\u043C\u043E\u0441. \u0406\u043C\u043E\u0432\u0456\u0440\u043D\u043E, \u0446\u0435 \u0437\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u0456 \u0430\u0441\u0442\u0435\u0440\u043E\u0457\u0434\u0438."
    audio: {fileID: 0}
  - id: mars_life
    question: "\u0427\u0438 \u043C\u043E\u0436\u043D\u0430 \u0436\u0438\u0442\u0438 \u043D\u0430 \u041C\u0430\u0440\u0441\u0456?"
    answer: "\u041F\u043E\u043A\u0438 \u0449\u043E \u043D\u0456: \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u0434\u0443\u0436\u0435 \u0440\u043E\u0437\u0440\u0456\u0434\u0436\u0435\u043D\u0435 \u0439 \u043C\u0430\u0439\u0436\u0435 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \u0432\u0443\u0433\u043B\u0435\u043A\u0438\u0441\u043B\u043E\u0433\u043E \u0433\u0430\u0437\u0443, \u0430 \u0432\u043D\u043E\u0447\u0456 \u0445\u043E\u043B\u043E\u0434\u043D\u043E \u0434\u043E \u043C\u0456\u043D\u0443\u0441 100 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432. \u0410\u043B\u0435 \u0432\u0447\u0435\u043D\u0456 \u0432\u0441\u0435\u0440\u0439\u043E\u0437 \u043F\u043B\u0430\u043D\u0443\u044E\u0442\u044C \u043F\u043E\u043B\u044C\u043E\u0442\u0438 \u043B\u044E\u0434\u0435\u0439 \u043D\u0430 \u041C\u0430\u0440\u0441."
    audio: {fileID: 0}
  - id: mars_red
    question: "\u0427\u043E\u043C\u0443 \u041C\u0430\u0440\u0441 \u0447\u0435\u0440\u0432\u043E\u043D\u0438\u0439?"
    answer: "\u0490\u0440\u0443\u043D\u0442 \u041C\u0430\u0440\u0441\u0430 \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u0431\u0430\u0433\u0430\u0442\u043E \u043E\u043A\u0441\u0438\u0434\u0443 \u0437\u0430\u043B\u0456\u0437\u0430 \u2014 \u043F\u043E \u0441\u0443\u0442\u0456, \u0456\u0440\u0436\u0456. \u0421\u0430\u043C\u0435 \u0432\u043E\u043D\u0430 \u043D\u0430\u0434\u0430\u0454 \u043F\u043B\u0430\u043D\u0435\u0442\u0456 \u0447\u0435\u0440\u0432\u043E\u043D\u0443\u0432\u0430\u0442\u043E\u0433\u043E \u043A\u043E\u043B\u044C\u043E\u0440\u0443."
    audio: {fileID: 0}
