  m_Script: {fileID: 11500000, guid: 3f755dfdaff50f641985bf07b6b22318, type: 3}
  m_Name: UranusData
  m_EditorClassIdentifier: Assembly-CSharp::SolarSystemAR.Core.PlanetData
  id: 6
  displayName: "\u0423\u0440\u0430\u043d"
  planetType: "\u041a\u0440\u0438\u0436\u0430\u043d\u0438\u0439 \u0433\u0456\u0433\u0430\u043d\u0442"
  diameterKm: 50724
  distanceFromSunMillionKm: 2867
  dayDuration: "17 \u0433\u043e\u0434\u0438\u043d 14 \u0445\u0432\u0438\u043b\u0438\u043d"
  yearDuration: "84 \u0437\u0435\u043c\u043d\u0456 \u0440\u043e\u043a\u0438"
  moonCount: 29
  interestingFact: "\u0423\u0440\u0430\u043d \u043e\u0431\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f, \u043b\u0435\u0436\u0430\u0447\u0438 \u043d\u0430 \u0431\u043e\u0446\u0456. \u0427\u0435\u0440\u0435\u0437 \u0446\u0435 \u043a\u043e\u0436\u0435\u043d \u0439\u043e\u0433\u043e \u043f\u043e\u043b\u044e\u0441 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e 42 \u0440\u043e\u043a\u0438 \u043e\u0441\u0432\u0456\u0442\u043b\u0435\u043d\u0438\u0439 \u0421\u043e\u043d\u0446\u0435\u043c, \u0430 \u043f\u043e\u0442\u0456\u043c \u0441\u0442\u0456\u043b\u044c\u043a\u0438 \u0436 \u0440\u043e\u043a\u0456\u0432 \u0437\u0430\u043d\u0443\u0440\u0435\u043d\u0438\u0439 \u0443 \u0442\u0435\u043c\u0440\u044f\u0432\u0443."
  discoveryHistory: "\u0423\u0440\u0430\u043d \u2014 \u043f\u0435\u0440\u0448\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0430, \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0430 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f\u0430. \u0426\u0435 \u0437\u0440\u043e\u0431\u0438\u0432 \u0412\u0456\u043b\u044c\u044f\u043c \u0413\u0435\u0440\u0448\u0435\u043b\u044c 13 \u0431\u0435\u0440\u0435\u0437\u043d\u044f 1781 \u0440\u043e\u043a\u0443; \u0441\u043f\u0435\u0440\u0448\u0443 \u0432\u0456\u043d \u043f\u043e\u0434\u0443\u043c\u0430\u0432, \u0449\u043e \u0437\u043d\u0430\u0439\u0448\u043e\u0432 \u043a\u043e\u043c\u0435\u0442\u0443. \u0404\u0434\u0438\u043d\u0438\u0439 \u0430\u043f\u0430\u0440\u0430\u0442, \u0449\u043e \u043f\u0440\u043e\u043b\u0456\u0442\u0430\u0432 \u043f\u043e\u0440\u0443\u0447, \u2014 \u0412\u043e\u044f\u0434\u0436\u0435\u0440-2 \u0443 1986 \u0440\u043e\u0446\u0456."
  questions:
  - id: uranus_moons
    question: "\u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0456\u0432 \u0443 \u0423\u0440\u0430\u043d\u0430?"
    answer: "\u0412 \u0423\u0440\u0430\u043d\u0430 \u0432\u0456\u0434\u043e\u043c\u043e 29 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0456\u0432. \u0407\u0445 \u043d\u0430\u0437\u0432\u0430\u043b\u0438 \u043d\u0430 \u0447\u0435\u0441\u0442\u044c \u0433\u0435\u0440\u043e\u0457\u0432 \u0442\u0432\u043e\u0440\u0456\u0432 \u0428\u0435\u043a\u0441\u043f\u0456\u0440\u0430 \u0442\u0430 \u041f\u043e\u0443\u043f\u0430, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \u0422\u0438\u0442\u0430\u043d\u0456\u044f \u0439 \u041e\u0431\u0435\u0440\u043e\u043d."
    audio: {fileID: 0}
  - id: uranus_life
    question: "\u0427\u0438 \u043c\u043e\u0436\u043d\u0430 \u0436\u0438\u0442\u0438 \u043d\u0430 \u0423\u0440\u0430\u043d\u0456?"
    answer: "\u041d\u0456. \u0423\u0440\u0430\u043d \u2014 \u043a\u0440\u0438\u0436\u0430\u043d\u0438\u0439 \u0433\u0456\u0433\u0430\u043d\u0442 \u0456\u0437 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u043e\u044e \u0431\u043b\u0438\u0437\u044c\u043a\u043e \u043c\u0456\u043d\u0443\u0441 220 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432 \u0456 \u0431\u0435\u0437 \u0442\u0432\u0435\u0440\u0434\u043e\u0457 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u0456."
    audio: {fileID: 0}
  - id: uranus_side
    question: "\u0427\u043e\u043c\u0443 \u0423\u0440\u0430\u043d \u043b\u0435\u0436\u0438\u0442\u044c \u043d\u0430 \u0431\u043e\u0446\u0456?"
    answer: "\u0406\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u043a\u043e\u043b\u0438\u0441\u044c \u0434\u0430\u0432\u043d\u043e \u0432 \u0423\u0440\u0430\u043d \u0432\u0440\u0456\u0437\u0430\u043b\u043e\u0441\u044f \u0432\u0435\u043b\u0438\u043a\u0435 \u043d\u0435\u0431\u0435\u0441\u043d\u0435 \u0442\u0456\u043b\u043e \u0439 \u043f\u0435\u0440\u0435\u043a\u0438\u043d\u0443\u043b\u043e \u0439\u043e\u0433\u043e. \u0422\u0435\u043f\u0435\u0440 \u0439\u043e\u0433\u043e \u0432\u0456\u0441\u044c \u043d\u0430\u0445\u0438\u043b\u0435\u043d\u0430 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e \u043d\u0430 98 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432, \u0456 \u043f\u043b\u0430\u043d\u0435\u0442\u0430 \u043d\u0456\u0431\u0438 \u043a\u043e\u0442\u0438\u0442\u044c\u0441\u044f \u043f\u043e \u043e\u0440\u0431\u0456\u0442\u0456."
    audio: {fileID: 0}
