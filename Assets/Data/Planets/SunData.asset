  m_Name: SunData
  m_EditorClassIdentifier: Assembly-CSharp::SolarSystemAR.Core.PlanetData
  id: 8
  displayName: "\u0421\u043e\u043d\u0446\u0435"
  image: {fileID: 21300000, guid: 04f6750ab44845488236e110c6f4bc5d, type: 3}
  planetType: "\u0417\u043e\u0440\u044f, \u0436\u043e\u0432\u0442\u0438\u0439 \u043a\u0430\u0440\u043b\u0438\u043a"
  diameterKm: 1392700
  distanceFromSunMillionKm: 0
  dayDuration: "\u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e 25 \u0437\u0435\u043c\u043d\u0438\u0445 \u0434\u0456\u0431"
  yearDuration: 
  moonCount: 0
  interestingFact: "\u0421\u043e\u043d\u0446\u0435 \u043c\u0456\u0441\u0442\u0438\u0442\u044c 99,8 \u0432\u0456\u0434\u0441\u043e\u0442\u043a\u0430 \u043c\u0430\u0441\u0438 \u0432\u0441\u0456\u0454\u0457 \u0421\u043e\u043d\u044f\u0447\u043d\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438. \u0412\u043e\u043d\u043e \u0442\u0430\u043a\u0435 \u0432\u0435\u043b\u0438\u043a\u0435, \u0449\u043e \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0456 \u043d\u044c\u043e\u0433\u043e \u043f\u043e\u043c\u0456\u0441\u0442\u0438\u043b\u043e\u0441\u044f \u0431 \u043f\u043e\u043d\u0430\u0434 \u043c\u0456\u043b\u044c\u0439\u043e\u043d \u0442\u0430\u043a\u0438\u0445 \u043f\u043b\u0430\u043d\u0435\u0442, \u044f\u043a \u0417\u0435\u043c\u043b\u044f."
  discoveryHistory: "\u041b\u044e\u0434\u0438 \u0441\u043f\u043e\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u043b\u0438 \u0421\u043e\u043d\u0446\u0435 \u0437 \u043d\u0430\u0439\u0434\u0430\u0432\u043d\u0456\u0448\u0438\u0445 \u0447\u0430\u0441\u0456\u0432, \u0456 \u0431\u0430\u0433\u0430\u0442\u043e \u043d\u0430\u0440\u043e\u0434\u0456\u0432 \u0432\u0432\u0430\u0436\u0430\u043b\u0438 \u0439\u043e\u0433\u043e \u0431\u043e\u0436\u0435\u0441\u0442\u0432\u043e\u043c. \u0423 1543 \u0440\u043e\u0446\u0456 \u041c\u0438\u043a\u043e\u043b\u0430 \u041a\u043e\u043f\u0435\u0440\u043d\u0438\u043a \u043f\u043e\u044f\u0441\u043d\u0438\u0432, \u0449\u043e \u0446\u0435 \u0417\u0435\u043c\u043b\u044f \u043e\u0431\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u043d\u0430\u0432\u043a\u043e\u043b\u043e \u0421\u043e\u043d\u0446\u044f, \u0430 \u043d\u0435 \u043d\u0430\u0432\u043f\u0430\u043a\u0438. \u0413\u0430\u043b\u0456\u043b\u0435\u043e \u0413\u0430\u043b\u0456\u043b\u0435\u0439 \u0443 \u0442\u0435\u043b\u0435\u0441\u043a\u043e\u043f \u0440\u043e\u0437\u0433\u043b\u0435\u0434\u0456\u0432 \u043d\u0430 \u0421\u043e\u043d\u0446\u0456 \u0442\u0435\u043c\u043d\u0456 \u043f\u043b\u044f\u043c\u0438 \u0456 \u0437\u0430 \u043d\u0438\u043c\u0438 \u043f\u043e\u043c\u0456\u0442\u0438\u0432, \u0449\u043e \u0432\u043e\u043d\u043e \u043e\u0431\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f. \u0410 \u0437 2018 \u0440\u043e\u043a\u0443 \u0434\u043e \u0421\u043e\u043d\u0446\u044f \u0431\u043b\u0438\u0436\u0447\u0435 \u0437\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u0456\u043d\u0448\u0438\u0439 \u0430\u043f\u0430\u0440\u0430\u0442 \u043f\u0456\u0434\u043b\u0456\u0442\u0430\u0454 \u0437\u043e\u043d\u0434 \u00ab\u041f\u0430\u0440\u043a\u0435\u0440\u00bb."
  questions:
  - id: sun_age
    question: "\u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u0440\u043e\u043a\u0456\u0432 \u0421\u043e\u043d\u0446\u044e?"
    answer: "\u0421\u043e\u043d\u0446\u044e \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e 4,6 \u043c\u0456\u043b\u044c\u044f\u0440\u0434\u0430 \u0440\u043e\u043a\u0456\u0432. \u0412\u043e\u043d\u043e \u0441\u0432\u0456\u0442\u0438\u0442\u0438\u043c\u0435 \u0449\u0435 \u0431\u043b\u0438\u0437\u044c\u043a\u043e 5 \u043c\u0456\u043b\u044c\u044f\u0440\u0434\u0456\u0432 \u0440\u043e\u043a\u0456\u0432."
    audio: {fileID: 0}
  - id: sun_temperature
    question: "\u042f\u043a\u0430 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0421\u043e\u043d\u0446\u044f?"
    answer: "\u041d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u0456 \u0421\u043e\u043d\u0446\u044f \u0431\u043b\u0438\u0437\u044c\u043a\u043e 5500 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432, \u0430 \u0432 \u0439\u043e\u0433\u043e \u044f\u0434\u0440\u0456 \u2014 \u043f\u043e\u043d\u0430\u0434 15 \u043c\u0456\u043b\u044c\u0439\u043e\u043d\u0456\u0432 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432."
    audio: {fileID: 0}
  - id: sun_light
    question: "\u042f\u043a \u0434\u043e\u0432\u0433\u043e \u043b\u0435\u0442\u0438\u0442\u044c \u0441\u043e\u043d\u044f\u0447\u043d\u0435 \u0441\u0432\u0456\u0442\u043b\u043e?"
    answer: "\u0421\u043e\u043d\u044f\u0447\u043d\u0435 \u0441\u0432\u0456\u0442\u043b\u043e \u0434\u043e\u043b\u0456\u0442\u0430\u0454 \u0434\u043e \u0417\u0435\u043c\u043b\u0456 \u043f\u0440\u0438\u0431\u043b\u0438\u0437\u043d\u043e \u0437\u0430 8 \u0445\u0432\u0438\u043b\u0438\u043d 20 \u0441\u0435\u043a\u0443\u043d\u0434."
    audio: {fileID: 0}
  - id: sun_made_of
    question: "\u0417 \u0447\u043e\u0433\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0421\u043e\u043d\u0446\u0435?"
    answer: "\u0421\u043e\u043d\u0446\u0435 \u2014 \u0446\u0435 \u0432\u0435\u043b\u0438\u0447\u0435\u0437\u043d\u0430 \u043a\u0443\u043b\u044f \u0440\u043e\u0437\u0436\u0430\u0440\u0435\u043d\u043e\u0433\u043e \u0433\u0430\u0437\u0443, \u043f\u0435\u0440\u0435\u0432\u0430\u0436\u043d\u043e \u0432\u043e\u0434\u043d\u044e \u0442\u0430 \u0433\u0435\u043b\u0456\u044e. \u0423 \u0439\u043e\u0433\u043e \u044f\u0434\u0440\u0456 \u0432\u043e\u0434\u0435\u043d\u044c \u043f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u043d\u0430 \u0433\u0435\u043b\u0456\u0439, \u0456 \u0441\u0430\u043c\u0435 \u0442\u0430\u043a \u043d\u0430\u0440\u043e\u0434\u0436\u0443\u044e\u0442\u044c\u0441\u044f \u0441\u0432\u0456\u0442\u043b\u043e \u0439 \u0442\u0435\u043f\u043b\u043e."
    audio: {fileID: 0}
