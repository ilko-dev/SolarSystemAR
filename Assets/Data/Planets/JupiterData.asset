  m_Script: {fileID: 11500000, guid: 3f755dfdaff50f641985bf07b6b22318, type: 3}
  m_Name: JupiterData
  m_EditorClassIdentifier: Assembly-CSharp::SolarSystemAR.Core.PlanetData
  id: 4
  displayName: "\u042e\u043f\u0456\u0442\u0435\u0440"
  planetType: "\u0413\u0430\u0437\u043e\u0432\u0438\u0439 \u0433\u0456\u0433\u0430\u043d\u0442"
  diameterKm: 139820
  distanceFromSunMillionKm: 778.5
  dayDuration: "9 \u0433\u043e\u0434\u0438\u043d 56 \u0445\u0432\u0438\u043b\u0438\u043d"
  yearDuration: "12 \u0437\u0435\u043c\u043d\u0438\u0445 \u0440\u043e\u043a\u0456\u0432"
  moonCount: 95
  interestingFact: "\u042e\u043f\u0456\u0442\u0435\u0440 \u2014 \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0430: \u0443 \u043d\u044c\u043e\u043c\u0443 \u0432\u043c\u0456\u0441\u0442\u0438\u043b\u043e\u0441\u044f \u0431 \u043f\u043e\u043d\u0430\u0434 \u0442\u0438\u0441\u044f\u0447\u0443 \u0442\u0430\u043a\u0438\u0445 \u043f\u043b\u0430\u043d\u0435\u0442, \u044f\u043a \u0417\u0435\u043c\u043b\u044f. \u0410 \u0439\u043e\u0433\u043e \u0412\u0435\u043b\u0438\u043a\u0430 \u0447\u0435\u0440\u0432\u043e\u043d\u0430 \u043f\u043b\u044f\u043c\u0430 \u2014 \u0446\u0435 \u0448\u0442\u043e\u0440\u043c, \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u0437\u0430 \u0432\u0441\u044e \u043d\u0430\u0448\u0443 \u043f\u043b\u0430\u043d\u0435\u0442\u0443."
  discoveryHistory: "\u042e\u043f\u0456\u0442\u0435\u0440 \u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u0437 \u0434\u0430\u0432\u043d\u0456\u0445 \u0447\u0430\u0441\u0456\u0432. \u0423 1610 \u0440\u043e\u0446\u0456 \u0413\u0430\u043b\u0456\u043b\u0435\u043e \u0413\u0430\u043b\u0456\u043b\u0435\u0439 \u0432\u0456\u0434\u043a\u0440\u0438\u0432 \u0447\u043e\u0442\u0438\u0440\u0438 \u0439\u043e\u0433\u043e \u043d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0456 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0438 \u2014 \u0406\u043e, \u0404\u0432\u0440\u043e\u043f\u0443, \u0413\u0430\u043d\u0456\u043c\u0435\u0434 \u0456 \u041a\u0430\u043b\u043b\u0456\u0441\u0442\u043e, \u2014 \u0442\u0435\u043f\u0435\u0440 \u0457\u0445 \u043d\u0430\u0437\u0438\u0432\u0430\u044e\u0442\u044c \u0433\u0430\u043b\u0456\u043b\u0435\u0454\u0432\u0438\u043c\u0438. \u0417 2016 \u0440\u043e\u043a\u0443 \u043f\u043b\u0430\u043d\u0435\u0442\u0443 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0454 \u0430\u043f\u0430\u0440\u0430\u0442 \u042e\u043d\u043e\u043d\u0430."
  questions:
  - id: jupiter_moons
    question: "\u0421\u043a\u0456\u043b\u044c\u043a\u0438 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0456\u0432 \u0443 \u042e\u043f\u0456\u0442\u0435\u0440\u0430?"
    answer: "\u0423 \u042e\u043f\u0456\u0442\u0435\u0440\u0430 \u0432\u0456\u0434\u043e\u043c\u043e \u043f\u043e\u043d\u0430\u0434 90 \u0441\u0443\u043f\u0443\u0442\u043d\u0438\u043a\u0456\u0432, \u0456 \u0430\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u044e\u0442\u044c \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0438 \u043d\u043e\u0432\u0456. \u041d\u0430\u0439\u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u0437 \u043d\u0438\u0445, \u0413\u0430\u043d\u0456\u043c\u0435\u0434, \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u0437\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0443 \u041c\u0435\u0440\u043a\u0443\u0440\u0456\u0439."
    audio: {fileID: 0}
  - id: jupiter_life
    question: "\u0427\u0438 \u043c\u043e\u0436\u043d\u0430 \u0436\u0438\u0442\u0438 \u043d\u0430 \u042e\u043f\u0456\u0442\u0435\u0440\u0456?"
    answer: "\u041d\u0456. \u042e\u043f\u0456\u0442\u0435\u0440 \u2014 \u0433\u0430\u0437\u043e\u0432\u0438\u0439 \u0433\u0456\u0433\u0430\u043d\u0442, \u0443 \u043d\u044c\u043e\u0433\u043e \u043d\u0435\u043c\u0430\u0454 \u0442\u0432\u0435\u0440\u0434\u043e\u0457 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u0456, \u043d\u0430 \u044f\u043a\u0443 \u043c\u043e\u0436\u043d\u0430 \u0441\u0442\u0430\u0442\u0438."
    audio: {fileID: 0}
  - id: jupiter_spot
    question: "\u0429\u043e \u0442\u0430\u043a\u0435 \u0412\u0435\u043b\u0438\u043a\u0430 \u0447\u0435\u0440\u0432\u043e\u043d\u0430 \u043f\u043b\u044f\u043c\u0430?"
    answer: "\u0426\u0435 \u0432\u0435\u043b\u0438\u0447\u0435\u0437\u043d\u0438\u0439 \u0448\u0442\u043e\u0440\u043c \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0456 \u042e\u043f\u0456\u0442\u0435\u0440\u0430, \u0431\u0456\u043b\u044c\u0448\u0438\u0439 \u0437\u0430 \u0432\u0441\u044e \u0417\u0435\u043c\u043b\u044e. \u0410\u0441\u0442\u0440\u043e\u043d\u043e\u043c\u0438 \u0441\u043f\u043e\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c \u0439\u043e\u0433\u043e \u0432\u0436\u0435 \u043f\u043e\u043d\u0430\u0434 150 \u0440\u043e\u043a\u0456\u0432."
    audio: {fileID: 0}
