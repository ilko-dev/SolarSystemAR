  id: 1
  displayName: "\u0412\u0435\u043D\u0435\u0440\u0430"
  image: {fileID: 21300000, guid: aa63e4c59ef2e914ba732f171d32cda7, type: 3}
  planetType: "\u041F\u043B\u0430\u043D\u0435\u0442\u0430 \u0437\u0435\u043C\u043D\u043E\u0457 \u0433\u0440\u0443\u043F\u0438"
  diameterKm: 12104
  distanceFromSunMillionKm: 108.2
  dayDuration: "243 \u0437\u0435\u043C\u043D\u0456 \u0434\u043E\u0431\u0438"
  yearDuration: "225 \u0437\u0435\u043C\u043D\u0438\u0445 \u0434\u0456\u0431"
  moonCount: 0
  interestingFact: "\u0412\u0435\u043D\u0435\u0440\u0430 \u2014 \u043D\u0430\u0439\u0433\u0430\u0440\u044F\u0447\u0456\u0448\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u0421\u043E\u043D\u044F\u0447\u043D\u043E\u0457 \u0441\u0438\u0441\u0442\u0435\u043C\u0438, \u0445\u043E\u0447\u0430 \u0439 \u043D\u0435 \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0430 \u0434\u043E \u0421\u043E\u043D\u0446\u044F. \u0410 \u0449\u0435 \u0432\u043E\u043D\u0430 \u043E\u0431\u0435\u0440\u0442\u0430\u0454\u0442\u044C\u0441\u044F \u0443 \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u043E\u043C\u0443 \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443, \u0442\u043E\u0436 \u0421\u043E\u043D\u0446\u0435 \u0442\u0430\u043C \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430 \u0437\u0430\u0445\u043E\u0434\u0456, \u0430 \u043E\u0431\u0435\u0440\u0442 \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u043E\u0441\u0456 \u0442\u0440\u0438\u0432\u0430\u0454 \u0434\u043E\u0432\u0448\u0435, \u043D\u0456\u0436 \u0440\u0456\u043A."
  discoveryHistory: "\u0412\u0435\u043D\u0435\u0440\u0443 \u0437\u043D\u0430\u043B\u0438 \u0449\u0435 \u0434\u0430\u0432\u043D\u0456 \u0432\u0430\u0432\u0438\u043B\u043E\u043D\u044F\u043D\u0438 \u2014 \u0446\u0435 \u043D\u0430\u0439\u044F\u0441\u043A\u0440\u0430\u0432\u0456\u0448\u0430 \xAB\u0437\u0456\u0440\u043A\u0430\xBB \u043D\u0430 \u043D\u0430\u0448\u043E\u043C\u0443 \u043D\u0435\u0431\u0456. \u0423 1610 \u0440\u043E\u0446\u0456 \u0413\u0430\u043B\u0456\u043B\u0435\u0439 \u043F\u043E\u0431\u0430\u0447\u0438\u0432 \u0443 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F \u0457\u0457 \u0444\u0430\u0437\u0438, \u0456 \u0446\u0435 \u0441\u0442\u0430\u043B\u043E \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u043C \u0434\u043E\u043A\u0430\u0437\u043E\u043C \u0442\u043E\u0433\u043E, \u0449\u043E \u043F\u043B\u0430\u043D\u0435\u0442\u0438 \u043E\u0431\u0435\u0440\u0442\u0430\u044E\u0442\u044C\u0441\u044F \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u0421\u043E\u043D\u0446\u044F. \u0423 1970 \u0440\u043E\u0446\u0456 \u0440\u0430\u0434\u044F\u043D\u0441\u044C\u043A\u0438\u0439 \u0430\u043F\u0430\u0440\u0430\u0442 \u0412\u0435\u043D\u0435\u0440\u0430-7 \u0432\u043F\u0435\u0440\u0448\u0435 \u0432 \u0456\u0441\u0442\u043E\u0440\u0456\u0457 \u043F\u0435\u0440\u0435\u0434\u0430\u0432 \u0434\u0430\u043D\u0456 \u0437 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u0456\u043D\u0448\u043E\u0457 \u043F\u043B\u0430\u043D\u0435\u0442\u0438."
  questions:
  - id: venus_moons
    question: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432 \u0443 \u0412\u0435\u043D\u0435\u0440\u0438?"
    answer: "\u0423 \u0412\u0435\u043D\u0435\u0440\u0438 \u0442\u0435\u0436 \u043D\u0435\u043C\u0430\u0454 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432. \u0420\u0430\u0437\u043E\u043C \u0456\u0437 \u041C\u0435\u0440\u043A\u0443\u0440\u0456\u0454\u043C \u0446\u0435 \u0454\u0434\u0438\u043D\u0456 \u0442\u0430\u043A\u0456 \u043F\u043B\u0430\u043D\u0435\u0442\u0438."
    audio: {fileID: 0}
  - id: venus_life
    question: "\u0427\u0438 \u043C\u043E\u0436\u043D\u0430 \u0436\u0438\u0442\u0438 \u043D\u0430 \u0412\u0435\u043D\u0435\u0440\u0456?"
    answer: "\u041D\u0456. \u041D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u0431\u043B\u0438\u0437\u044C\u043A\u043E 465 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432, \u0442\u0438\u0441\u043A \u0443 90 \u0440\u0430\u0437\u0456\u0432 \u0431\u0456\u043B\u044C\u0448\u0438\u0439, \u043D\u0456\u0436 \u043D\u0430 \u0417\u0435\u043C\u043B\u0456, \u0430 \u0445\u043C\u0430\u0440\u0438 \u0441\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F \u0456\u0437 \u0441\u0456\u0440\u0447\u0430\u043D\u043E\u0457 \u043A\u0438\u0441\u043B\u043E\u0442\u0438."
    audio: {fileID: 0}
  - id: venus_hot
    question: "\u0427\u043E\u043C\u0443 \u0412\u0435\u043D\u0435\u0440\u0430 \u0442\u0430\u043A\u0430 \u0433\u0430\u0440\u044F\u0447\u0430?"
    answer: "\u0427\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u043D\u0438\u043A\u043E\u0432\u0438\u0439 \u0435\u0444\u0435\u043A\u0442. \u0413\u0443\u0441\u0442\u0430 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0437 \u0432\u0443\u0433\u043B\u0435\u043A\u0438\u0441\u043B\u043E\u0433\u043E \u0433\u0430\u0437\u0443 \u0437\u0430\u0442\u0440\u0438\u043C\u0443\u0454 \u0442\u0435\u043F\u043B\u043E, \u0442\u043E\u043C\u0443 \u0412\u0435\u043D\u0435\u0440\u0430 \u0433\u0430\u0440\u044F\u0447\u0456\u0448\u0430 \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0430 \u041C\u0435\u0440\u043A\u0443\u0440\u0456\u0439 \u2014 \u0431\u043B\u0438\u0437\u044C\u043A\u043E 465 \u0433\u0440\u0430\u0434\u0443\u0441\u0456\u0432."
    audio: {fileID: 0}
