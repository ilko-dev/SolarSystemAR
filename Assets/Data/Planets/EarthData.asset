  id: 2
  displayName: "\u0417\u0435\u043C\u043B\u044F"
  image: {fileID: 21300000, guid: c5dc3f4db33cc0740857db979c23b419, type: 3}
  planetType: "\u041F\u043B\u0430\u043D\u0435\u0442\u0430 \u0437\u0435\u043C\u043D\u043E\u0457 \u0433\u0440\u0443\u043F\u0438"
  diameterKm: 12742
  distanceFromSunMillionKm: 149.6
  dayDuration: "24 \u0433\u043E\u0434\u0438\u043D\u0438"
  yearDuration: "365 \u0434\u0456\u0431"
  moonCount: 1
  interestingFact: "\u0417\u0435\u043C\u043B\u044F \u2014 \u0454\u0434\u0438\u043D\u0430 \u0432\u0456\u0434\u043E\u043C\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430, \u043D\u0430 \u044F\u043A\u0456\u0439 \u0454 \u0436\u0438\u0442\u0442\u044F. \u0411\u043B\u0438\u0437\u044C\u043A\u043E 71 \u0432\u0456\u0434\u0441\u043E\u0442\u043A\u0430 \u0457\u0457 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456 \u0432\u043A\u0440\u0438\u0442\u043E \u0432\u043E\u0434\u043E\u044E, \u0442\u043E\u043C\u0443 \u0437 \u043A\u043E\u0441\u043C\u043E\u0441\u0443 \u0432\u043E\u043D\u0430 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454 \u0431\u043B\u0430\u043A\u0438\u0442\u043D\u043E\u044E."
  discoveryHistory: "\u0429\u0435 \u0432 \u0442\u0440\u0435\u0442\u044C\u043E\u043C\u0443 \u0441\u0442\u043E\u043B\u0456\u0442\u0442\u0456 \u0434\u043E \u043D\u0430\u0448\u043E\u0457 \u0435\u0440\u0438 \u0415\u0440\u0430\u0442\u043E\u0441\u0444\u0435\u043D \u0432\u0438\u043C\u0456\u0440\u044F\u0432 \u0440\u043E\u0437\u043C\u0456\u0440 \u0417\u0435\u043C\u043B\u0456 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0442\u0456\u043D\u0435\u0439. \u0423 1543 \u0440\u043E\u0446\u0456 \u041A\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u0430\u0432, \u0449\u043E \u0417\u0435\u043C\u043B\u044F \u043E\u0431\u0435\u0440\u0442\u0430\u0454\u0442\u044C\u0441\u044F \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u0421\u043E\u043D\u0446\u044F. \u0420\u0430\u043A\u0435\u0442\u0443, \u044F\u043A\u0430 \u0432\u043F\u0435\u0440\u0448\u0435 \u043F\u0456\u0434\u043D\u044F\u043B\u0430 \u043B\u044E\u0434\u0438\u043D\u0443 \u0432 \u043A\u043E\u0441\u043C\u043E\u0441, \u0441\u0442\u0432\u043E\u0440\u0438\u0432 \u0443\u0440\u043E\u0434\u0436\u0435\u043D\u0435\u0446\u044C \u0416\u0438\u0442\u043E\u043C\u0438\u0440\u0430 \u0421\u0435\u0440\u0433\u0456\u0439 \u041A\u043E\u0440\u043E\u043B\u044C\u043E\u0432. \u0410 \u0432 1997 \u0440\u043E\u0446\u0456 \u041B\u0435\u043E\u043D\u0456\u0434 \u041A\u0430\u0434\u0435\u043D\u044E\u043A \u0441\u0442\u0430\u0432 \u043F\u0435\u0440\u0448\u0438\u043C \u043A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442\u043E\u043C \u043D\u0435\u0437\u0430\u043B\u0435\u0436\u043D\u043E\u0457 \u0423\u043A\u0440\u0430\u0457\u043D\u0438."
  questions:
  - id: earth_moons
    question: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432 \u0443 \u0417\u0435\u043C\u043B\u0456?"
    answer: "\u0423 \u0417\u0435\u043C\u043B\u0456 \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0438\u0439 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A \u2014 \u041C\u0456\u0441\u044F\u0446\u044C. \u0412\u0456\u043D \u0432\u0456\u0434\u0434\u0430\u043B\u0435\u043D\u0438\u0439 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E \u043D\u0430 384 \u0442\u0438\u0441\u044F\u0447\u0456 \u043A\u0456\u043B\u043E\u043C\u0435\u0442\u0440\u0456\u0432."
    audio: {fileID: 0}
  - id: earth_life
    question: "\u0427\u0438 \u043C\u043E\u0436\u043D\u0430 \u0436\u0438\u0442\u0438 \u043D\u0430 \u0417\u0435\u043C\u043B\u0456?"
    answer: "\u0422\u0430\u043A! \u0417\u0435\u043C\u043B\u044F \u2014 \u0454\u0434\u0438\u043D\u0430 \u0432\u0456\u0434\u043E\u043C\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u0437 \u0436\u0438\u0442\u0442\u044F\u043C: \u0442\u0443\u0442 \u0454 \u0440\u0456\u0434\u043A\u0430 \u0432\u043E\u0434\u0430, \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u0434\u043B\u044F \u0434\u0438\u0445\u0430\u043D\u043D\u044F \u0442\u0430 \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u043A\u043E\u0441\u043C\u0456\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F."
    audio: {fileID: 0}
  - id: earth_sky
    question: "\u0427\u043E\u043C\u0443 \u043D\u0435\u0431\u043E \u0431\u043B\u0430\u043A\u0438\u0442\u043D\u0435?"
    answer: "\u0421\u043E\u043D\u044F\u0447\u043D\u0435 \u0441\u0432\u0456\u0442\u043B\u043E \u0440\u043E\u0437\u0441\u0456\u044E\u0454\u0442\u044C\u0441\u044F \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456, \u0456 \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435 \u0440\u043E\u0437\u0441\u0456\u044E\u0454\u0442\u044C\u0441\u044F \u0441\u0430\u043C\u0435 \u0441\u0438\u043D\u0454 \u0441\u0432\u0456\u0442\u043B\u043E. \u0422\u043E\u043C\u0443 \u0437 \u0443\u0441\u0456\u0445 \u0431\u043E\u043A\u0456\u0432 \u0434\u043E \u043D\u0430\u0448\u0438\u0445 \u043E\u0447\u0435\u0439 \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u0454 \u0431\u043B\u0430\u043A\u0438\u0442\u043D\u0438\u0439 \u043A\u043E\u043B\u0456\u0440."
    audio: {fileID: 0}
