  m_Name: NeptuneData
  m_EditorClassIdentifier: Assembly-CSharp::SolarSystemAR.Core.PlanetData
  id: 7
  displayName: "\u041D\u0435\u043F\u0442\u0443\u043D"
  image: {fileID: 21300000, guid: 2680aa259c0691a4abc3e921ed20448a, type: 3}
  planetType: "\u041A\u0440\u0438\u0436\u0430\u043D\u0438\u0439 \u0433\u0456\u0433\u0430\u043D\u0442"
  diameterKm: 49244
  distanceFromSunMillionKm: 4515
  dayDuration: "16 \u0433\u043E\u0434\u0438\u043D 6 \u0445\u0432\u0438\u043B\u0438\u043D"
  yearDuration: "165 \u0437\u0435\u043C\u043D\u0438\u0445 \u0440\u043E\u043A\u0456\u0432"
  moonCount: 16
  interestingFact: "\u041D\u0430 \u041D\u0435\u043F\u0442\u0443\u043D\u0456 \u043D\u0430\u0439\u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0456 \u0432\u0456\u0442\u0440\u0438 \u0432 \u0421\u043E\u043D\u044F\u0447\u043D\u0456\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0456 \u2014 \u0434\u043E \u0434\u0432\u043E\u0445 \u0442\u0438\u0441\u044F\u0447 \u043A\u0456\u043B\u043E\u043C\u0435\u0442\u0440\u0456\u0432 \u043D\u0430 \u0433\u043E\u0434\u0438\u043D\u0443. \u0410 \u0440\u0456\u043A \u0442\u0430\u043C \u0442\u0440\u0438\u0432\u0430\u0454 165 \u0437\u0435\u043C\u043D\u0438\u0445 \u0440\u043E\u043A\u0456\u0432: \u043F\u0456\u0441\u043B\u044F \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F \u0432 1846 \u0440\u043E\u0446\u0456 \u041D\u0435\u043F\u0442\u0443\u043D \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0432 \u043F\u0435\u0440\u0448\u0438\u0439 \u043F\u043E\u0432\u043D\u0438\u0439 \u043E\u0431\u0435\u0440\u0442 \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u0421\u043E\u043D\u0446\u044F \u043B\u0438\u0448\u0435 \u0443 2011 \u0440\u043E\u0446\u0456."
  discoveryHistory: "\u041D\u0435\u043F\u0442\u0443\u043D \u0432\u0456\u0434\u043A\u0440\u0438\u043B\u0438 \xAB\u043D\u0430 \u043A\u0456\u043D\u0447\u0438\u043A\u0443 \u043F\u0435\u0440\u0430\xBB: \u0444\u0440\u0430\u043D\u0446\u0443\u0437\u044C\u043A\u0438\u0439 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A \u0423\u0440\u0431\u0435\u043D \u041B\u0435\u0432\u0435\u0440'\u0454 \u043E\u0431\u0447\u0438\u0441\u043B\u0438\u0432, \u0434\u0435 \u043C\u0430\u0454 \u0431\u0443\u0442\u0438 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430, \u0449\u043E \u0437\u0431\u0443\u0440\u044E\u0454 \u0440\u0443\u0445 \u0423\u0440\u0430\u043D\u0430. 23 \u0432\u0435\u0440\u0435\u0441\u043D\u044F 1846 \u0440\u043E\u043A\u0443 \u0419\u043E\u0433\u0430\u043D\u043D \u0413\u0430\u043B\u043B\u0435 \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0457\u0457 \u0432 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F \u0441\u0430\u043C\u0435 \u0442\u0430\u043C. \u0423 1989 \u0440\u043E\u0446\u0456 \u043F\u043E\u0432\u0437 \u041D\u0435\u043F\u0442\u0443\u043D \u043F\u0440\u043E\u043B\u0435\u0442\u0456\u0432 \u0412\u043E\u044F\u0434\u0436\u0435\u0440-2."
  questions:
  - id: neptune_moons
    question: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432 \u0443 \u041D\u0435\u043F\u0442\u0443\u043D\u0430?"
    answer: "\u0423 \u041D\u0435\u043F\u0442\u0443\u043D\u0430 16 \u0432\u0456\u0434\u043E\u043C\u0438\u0445 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432. \u041D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0438\u0439, \u0422\u0440\u0438\u0442\u043E\u043D, \u043E\u0431\u0435\u0440\u0442\u0430\u0454\u0442\u044C\u0441\u044F \u0443 \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u043E\u043C\u0443 \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443 \u2014 \u0456\u043C\u043E\u0432\u0456\u0440\u043D\u043E, \u043A\u043E\u043B\u0438\u0441\u044C \u0439\u043E\u0433\u043E \u0437\u0430\u0445\u043E\u043F\u0438\u043B\u0430 \u0433\u0440\u0430\u0432\u0456\u0442\u0430\u0446\u0456\u044F \u041D\u0435\u043F\u0442\u0443\u043D\u0430."
    audio: {fileID: 0}
  - id: neptune_life
    question: "\u0427\u0438 \u043C\u043E\u0436\u043D\u0430 \u0436\u0438\u0442\u0438 \u043D\u0430 \u041D\u0435\u043F\u0442\u0443\u043D\u0456?"
    answer: "\u041D\u0456. \u0422\u0430\u043C \u0434\u0443\u0436\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E, \u043D\u0435\u043C\u0430\u0454 \u0442\u0432\u0435\u0440\u0434\u043E\u0457 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456, \u0430 \u0432\u0456\u0442\u0440\u0438 \u0434\u043C\u0443\u0442\u044C \u0437\u0456 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044E \u0434\u043E \u0434\u0432\u043E\u0445 \u0442\u0438\u0441\u044F\u0447 \u043A\u0456\u043B\u043E\u043C\u0435\u0442\u0440\u0456\u0432 \u043D\u0430 \u0433\u043E\u0434\u0438\u043D\u0443."
    audio: {fileID: 0}
  - id: neptune_blue
    question: "\u0427\u043E\u043C\u0443 \u041D\u0435\u043F\u0442\u0443\u043D \u0441\u0438\u043D\u0456\u0439?"
    answer: "\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u041D\u0435\u043F\u0442\u0443\u043D\u0430 \u043C\u0456\u0441\u0442\u0438\u0442\u044C \u043C\u0435\u0442\u0430\u043D, \u044F\u043A\u0438\u0439 \u043F\u043E\u0433\u043B\u0438\u043D\u0430\u0454 \u0447\u0435\u0440\u0432\u043E\u043D\u0435 \u0441\u0432\u0456\u0442\u043B\u043E \u0439 \u0432\u0456\u0434\u0431\u0438\u0432\u0430\u0454 \u0441\u0438\u043D\u0454. \u0422\u043E\u043C\u0443 \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454 \u0441\u0438\u043D\u044C\u043E\u044E."
    audio: {fileID: 0}
