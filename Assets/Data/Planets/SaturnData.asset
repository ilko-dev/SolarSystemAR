  m_Name: SaturnData
  m_EditorClassIdentifier: Assembly-CSharp::SolarSystemAR.Core.PlanetData
  id: 5
  displayName: "\u0421\u0430\u0442\u0443\u0440\u043D"
  image: {fileID: 21300000, guid: 6e7bd4bda0a882144a6525dd090e71ea, type: 3}
  planetType: "\u0413\u0430\u0437\u043E\u0432\u0438\u0439 \u0433\u0456\u0433\u0430\u043D\u0442"
  diameterKm: 116460
  distanceFromSunMillionKm: 1432
  dayDuration: "10 \u0433\u043E\u0434\u0438\u043D 33 \u0445\u0432\u0438\u043B\u0438\u043D\u0438"
  yearDuration: "29 \u0437\u0435\u043C\u043D\u0438\u0445 \u0440\u043E\u043A\u0456\u0432"
  moonCount: 274
  interestingFact: "\u0421\u0430\u0442\u0443\u0440\u043D \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438 \u043B\u0435\u0433\u043A\u0438\u0439 \u0434\u043B\u044F \u0441\u0432\u043E\u0433\u043E \u0440\u043E\u0437\u043C\u0456\u0440\u0443, \u0449\u043E \u0439\u043E\u0433\u043E \u0441\u0435\u0440\u0435\u0434\u043D\u044F \u0433\u0443\u0441\u0442\u0438\u043D\u0430 \u043C\u0435\u043D\u0448\u0430, \u043D\u0456\u0436 \u0443 \u0432\u043E\u0434\u0438. \u042F\u043A\u0431\u0438 \u0456\u0441\u043D\u0443\u0432\u0430\u043B\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u0432\u0435\u043B\u0438\u043A\u0430 \u0432\u0430\u043D\u043D\u0430, \u0421\u0430\u0442\u0443\u0440\u043D \u0431\u0438 \u0432 \u043D\u0456\u0439 \u043F\u043B\u0430\u0432\u0430\u0432."
  discoveryHistory: "\u0421\u0430\u0442\u0443\u0440\u043D \u2014 \u043D\u0430\u0439\u0432\u0456\u0434\u0434\u0430\u043B\u0435\u043D\u0456\u0448\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430, \u044F\u043A\u0443 \u0432\u0438\u0434\u043D\u043E \u043D\u0435\u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0438\u043C \u043E\u043A\u043E\u043C, \u0442\u043E\u0436 \u0439\u043E\u0433\u043E \u0437\u043D\u0430\u043B\u0438 \u0449\u0435 \u0432 \u0434\u0430\u0432\u043D\u0438\u043D\u0443. \u0413\u0430\u043B\u0456\u043B\u0435\u0439 \u0443 1610 \u0440\u043E\u0446\u0456 \u043F\u043E\u0431\u0430\u0447\u0438\u0432 \u0431\u0456\u043B\u044F \u043D\u044C\u043E\u0433\u043E \u0434\u0438\u0432\u043D\u0456 \xAB\u0432\u0443\u0448\u043A\u0430\xBB, \u0430 \u0432 1655 \u0440\u043E\u0446\u0456 \u0425\u0440\u0438\u0441\u0442\u0438\u044F\u043D \u0413\u044E\u0439\u0433\u0435\u043D\u0441 \u043F\u043E\u044F\u0441\u043D\u0438\u0432, \u0449\u043E \u0446\u0435 \u043A\u0456\u043B\u044C\u0446\u044F, \u0456 \u0432\u0456\u0434\u043A\u0440\u0438\u0432 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A \u0422\u0438\u0442\u0430\u043D. \u0417 2004 \u043F\u043E 2017 \u0440\u0456\u043A \u0421\u0430\u0442\u0443\u0440\u043D \u0432\u0438\u0432\u0447\u0430\u0432 \u0430\u043F\u0430\u0440\u0430\u0442 \u041A\u0430\u0441\u0441\u0456\u043D\u0456."
  questions:
  - id: saturn_moons
    question: "\u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432 \u0443 \u0421\u0430\u0442\u0443\u0440\u043D\u0430?"
    answer: "\u0423 \u0421\u0430\u0442\u0443\u0440\u043D\u0430 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435 \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432 \u0443 \u0421\u043E\u043D\u044F\u0447\u043D\u0456\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0456 \u2014 \u043F\u043E\u043D\u0430\u0434 270. \u041D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0438\u0439, \u0422\u0438\u0442\u0430\u043D, \u043C\u0430\u0454 \u0433\u0443\u0441\u0442\u0443 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443."
    audio: {fileID: 0}
  - id: saturn_life
    question: "\u0427\u0438 \u043C\u043E\u0436\u043D\u0430 \u0436\u0438\u0442\u0438 \u043D\u0430 \u0421\u0430\u0442\u0443\u0440\u043D\u0456?"
    answer: "\u041D\u0456, \u0421\u0430\u0442\u0443\u0440\u043D \u0442\u0435\u0436 \u0433\u0430\u0437\u043E\u0432\u0438\u0439 \u0433\u0456\u0433\u0430\u043D\u0442 \u0431\u0435\u0437 \u0442\u0432\u0435\u0440\u0434\u043E\u0457 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456. \u0410 \u043E\u0442 \u043D\u0430 \u0439\u043E\u0433\u043E \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0443 \u0415\u043D\u0446\u0435\u043B\u0430\u0434\u0456 \u043F\u0456\u0434 \u043B\u044C\u043E\u0434\u043E\u043C \u0454 \u043E\u043A\u0435\u0430\u043D \u0440\u0456\u0434\u043A\u043E\u0457 \u0432\u043E\u0434\u0438."
    audio: {fileID: 0}
  - id: saturn_rings
    question: "\u0417 \u0447\u043E\u0433\u043E \u0441\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F \u043A\u0456\u043B\u044C\u0446\u044F \u0421\u0430\u0442\u0443\u0440\u043D\u0430?"
    answer: "\u041A\u0456\u043B\u044C\u0446\u044F \u0421\u0430\u0442\u0443\u0440\u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0430\u044E\u0442\u044C\u0441\u044F \u0437 \u043C\u0456\u043B\u044C\u044F\u0440\u0434\u0456\u0432 \u0448\u043C\u0430\u0442\u043E\u0447\u043A\u0456\u0432 \u043B\u044C\u043E\u0434\u0443 \u0442\u0430 \u043A\u0430\u043C\u0435\u043D\u044E \u2014 \u0432\u0456\u0434 \u043F\u0456\u0449\u0438\u043D\u043E\u043A \u0434\u043E \u0431\u0440\u0438\u043B \u0437\u0430\u0432\u0431\u0456\u043B\u044C\u0448\u043A\u0438 \u0437 \u0431\u0443\u0434\u0438\u043D\u043E\u043A."
    audio: {fileID: 0}
